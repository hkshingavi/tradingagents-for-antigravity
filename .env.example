# =============================================================================
# TradingAgents for Antigravity - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini (Default recommended setup)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Dual-Tier Model Strategy:
# 1. Quick-Think Tier: Powers the 4 parallel analysts (data extraction & technicals)
TRADINGAGENTS_QUICK_THINK_PROVIDER=google
TRADINGAGENTS_QUICK_THINK_LLM=gemini-2.5-flash

# 2. Deep-Think Tier: Powers Bull/Bear debate, Risk Management, and Portfolio Manager
TRADINGAGENTS_DEEP_THINK_PROVIDER=google
TRADINGAGENTS_DEEP_THINK_LLM=gemini-2.5-pro
TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high

# -----------------------------------------------------------------------------
# Optional: Local Ollama Offload (Saves 75% cloud quota)
# Uncomment these to run data analysts on your local machine for $0:
# -----------------------------------------------------------------------------
# TRADINGAGENTS_QUICK_THINK_PROVIDER=ollama
# TRADINGAGENTS_QUICK_THINK_LLM=qwen2.5:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# -----------------------------------------------------------------------------
# SEC EDGAR Point-in-Time Filings (Free, requires contact name & email)
# -----------------------------------------------------------------------------
SEC_USER_AGENT=Harshad Shingavi harsadshingvi@gmail.com

